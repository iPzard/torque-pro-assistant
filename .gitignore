# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# python cache
app.pyc
__pycache__

# pyinstaller intermediate workpath (configured in scripts/build.js)
/.pyi-build

# python virtualenvs
venv/
.venv/
env/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/dist
/dist-electron
/resources/app
/resources/app.app

# editors
.idea/
# Track shared VS Code workspace settings (auto-fix on save, validate list)
# but keep per-user files (launch.json / tasks.json) ignored.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

# Claude Code — track shared project config, ignore per-user files.
.claude/*
!.claude/rules/
!.claude/agents/
